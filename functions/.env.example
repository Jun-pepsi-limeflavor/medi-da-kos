# Comma-separated admin notification recipients (loaded via firebase-functions params)
ADMIN_EMAILS=rheekw@techasset.co.kr,songjh@techasset.co.kr,kimhs@techasset.co.kr,parkjy@techasset.co.kr
# Gmail API From address. Must be domain-delegated to mail-ingest.
NOTIFY_FROM_EMAIL=support@medidakos.com

# Notion CRM sync (order -> Notion profile row, Notion row -> email history).
# NOTION_API_KEY is a secret — set it via Secret Manager, never here.
# Leave NOTION_DATABASE_ID empty to keep both Notion functions as no-ops.
NOTION_DATABASE_ID=
# Must match the actual property names/types in the target Notion database.
NOTION_PROP_NAME=이름
NOTION_PROP_EMAIL=이메일
NOTION_PROP_ITEMS=품목
NOTION_PROP_SYNCED=메일이력생성됨
NOTION_PROP_CREATED_AT=생성일


# "email" or "rich_text" — whichever type the 이메일 property actually is.
NOTION_EMAIL_PROPERTY_TYPE=email
