# 운영 배포값. 비밀값이 아니므로 커밋한다 — 비밀은 Secret Manager 에 둔다.
ADMIN_EMAILS=songjh@techasset.co.kr,parkjy@techasset.co.kr,kimbm@techasset.co.kr,kimhs@techasset.co.kr

# Channel Talk 웹 접수 연동 스위치. 2026-10-12 운영 활성화. OFF 기간 기록(intake_disabled)은 켜도 자동 처리하지 않는다.
CHANNELTALK_INTAKE_ENABLED=true

# Channel Talk lastContactAt 웹훅(channelTalkLastContactWebhook). 2026-10-21 운영 활성화.
# MODE: off | observe | on. ALLOW_USER_IDS: "" = 쓰기 없음, "*" = 전체 고객, 아니면 쉼표 구분 고객 id.
# 에뮬레이터·로컬 실험은 functions/.env.local(추적 안 함)에서 MODE=off 로 덮어쓴다.
CHANNELTALK_LAST_CONTACT_MODE=on
CHANNELTALK_LAST_CONTACT_ALLOW_USER_IDS=*
