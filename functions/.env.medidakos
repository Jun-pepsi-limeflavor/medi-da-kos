# 운영(medidakos) 배포 파라미터. functions/.env 위에 덮어쓴다. 비밀값은 Secret Manager에.
# 값은 2026-11-17 배포된 channelTalk* 함수 기준. dev 파일(.env.dev-medidakos-b9b4f)과 같은 키·순서를 유지한다.
NOTIFY_FROM_EMAIL=support@medidakos.com

CHANNELTALK_INTAKE_API_VERSION=2026-06-01
CHANNELTALK_INTAKE_BOT_NAME=웹 접수
CHANNELTALK_INTERNAL_DOMAINS=techasset.co.kr,medidakoslabs.com,medidakos.com
CHANNELTALK_TEST_DOMAIN=techasset.co.kr
CHANNELTALK_NOTE_MAX_LENGTH=4000

