# Google Analytics 4 / Meta Pixel — 환경별 선택은 src/lib/analytics/analytics-env.ts (fail-closed)
# Vercel Production은 *_ID(운영)만, 그 밖(Preview·staging·로컬)은 *_DEV_ID(개발)만 쓴다. 대체(fallback) 없음.
# 운영·개발 변수가 같은 값이면 둘 다 꺼지므로, 두 변수를 모든 환경에 함께 두는 것이 안전하다.
# Google Analytics 4
NEXT_PUBLIC_GA_ID="G-NQPD9VE63R"
NEXT_PUBLIC_GA_DEV_ID="G-5V5XTJ08H9"

# Meta Pixel (운영 Pixel / 개발 Dataset `Dev_Medidakos Pixel`)
NEXT_PUBLIC_META_PIXEL_ID="1450327583197410"
NEXT_PUBLIC_META_PIXEL_DEV_ID="1648105146762209"

# Channel Talk (채널 설정 → 일반 → 플러그인 관리 → 웹용 설치)
NEXT_PUBLIC_CHANNEL_TALK_PLUGIN_KEY=

# Member hash (채널 설정 → 보안 및 개발 → 사용자 데이터 암호화 → Secret key, hex)
# 설정 시 Firebase uid boot에 HMAC-SHA256 memberHash가 포함됩니다.
CHANNEL_TALK_MEMBER_HASH_SECRET=

# Google Search Console — HTML tag method only (DNS TXT users can leave empty)
GOOGLE_SITE_VERIFICATION=

# Favicon: place brand square PNG at src/app/favicon.ico (min 48×48; 512×512 recommended)



# true = mock auth + localStorage (local development only; never set in Vercel)
# false or unset = real Firebase (missing Firebase config is an error, no mock fallback)
NEXT_PUBLIC_USE_MOCK_AUTH=false

# Firebase Admin SDK service account (Channel Talk member-hash 토큰 검증), base64-encoded JSON — real value lives in Vercel only
FIREBASE_SERVICE_ACCOUNT_B64="eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCJ9"

# Instagram feed for Home "On social" (Meta Graph API, Unified Login system-user token) — server only, never NEXT_PUBLIC_
# Real values live in .env.local (local) and Vercel staging / Production only. Leave empty to show the empty state.
INSTAGRAM_ACCESS_TOKEN=
# Instagram professional account ID (@medidakos), from GET /me/assigned_instagram_accounts
INSTAGRAM_USER_ID=
