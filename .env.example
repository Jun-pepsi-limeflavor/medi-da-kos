# Google Analytics 4
NEXT_PUBLIC_GA_ID="G-NQPD9VE63R"

# Channel Talk (채널 설정 → 일반 → 플러그인 관리 → 웹용 설치)
NEXT_PUBLIC_CHANNEL_TALK_PLUGIN_KEY=

# Member hash (채널 설정 → 보안 및 개발 → 사용자 데이터 암호화 → Secret key, hex)
# 설정 시 Firebase uid boot에 HMAC-SHA256 memberHash가 포함됩니다.
CHANNEL_TALK_MEMBER_HASH_SECRET=

# Google Search Console — HTML tag method only (DNS TXT users can leave empty)
GOOGLE_SITE_VERIFICATION=

# Favicon: place brand square PNG at src/app/favicon.ico (min 48×48; 512×512 recommended)



# true = mock auth + localStorage (default when Firebase is empty)
# false = require Firebase
NEXT_PUBLIC_USE_MOCK_AUTH=false

# Backoffice admin allowlist — comma-separated emails, real values live in Vercel only
BACKOFFICE_ADMIN_EMAILS="admin@example.com,admin2@example.com"

# Firebase Admin SDK service account, base64-encoded JSON — real value lives in Vercel only
FIREBASE_SERVICE_ACCOUNT_B64="eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCJ9"

# Channel Talk Open API (수집기용) — 실제 값은 Vercel 에만 둔다
CHANNELTALK_ACCESS_KEY=
CHANNELTALK_ACCESS_SECRET=
CHANNELTALK_CHANNEL_VERSION="5"

# AWS Bedrock (메시지 파싱) — 실제 자격 증명은 Vercel 에만 둔다
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION="us-east-1"
BEDROCK_MODEL_ID="us.anthropic.claude-haiku-4-5-20251001-v1:0"
