rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // users/{uid}: 본인만. 권한 필드는 클라이언트 요청에 들어오지 않는다.
    match /users/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'phone', 'country', 'companyName',
          'provider', 'createdAt', 'isTest'
        ]);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phone', 'country', 'companyName', 'provider', 'isTest'
        ]);
      allow delete: if false;
    }

    // cmBriefs/{uid}: 본인만 읽기/쓰기 (setDoc/merge 사용)
    match /cmBriefs/{uid} {
      allow read, write: if isOwner(uid);
    }

    // orders/{orderId}: 본인 uid로만 생성, 본인 것만 읽기
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // sampleRequests/{requestId}: orders와 동일 패턴
    match /sampleRequests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // tracking/{uid}/entries/{entryId}: 본인 subcollection만 접근
    match /tracking/{uid} {
      allow read, write: if false;

      match /entries/{entryId} {
        allow read, write: if isOwner(uid);
      }
    }

    // test/{docId}: 로그인 사용자만
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // contact/{docId}: 비로그인 문의 폼 — create만 허용
    match /contact/{docId} {
      allow create: if
        request.resource.data.keys().hasAll(['companyName', 'email', 'message', 'status', 'createdAt'])
        && request.resource.data.companyName is string
        && request.resource.data.companyName.size() > 0
        && request.resource.data.companyName.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.matches('.*@.*\\..*')
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'submitted';
      allow read, update, delete: if false;
    }

    // koreaLeads/{docId}: 콜드메일 랜딩(/korea) 문의 폼 — create만 허용
    match /koreaLeads/{docId} {
      allow create: if
        request.resource.data.keys().hasAll(['companyName', 'email', 'message', 'expectedVolume', 'status', 'createdAt'])
        && request.resource.data.companyName is string
        && request.resource.data.companyName.size() > 0
        && request.resource.data.companyName.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.matches('.*@.*\\..*')
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.expectedVolume is string
        && request.resource.data.expectedVolume.size() > 0
        && request.resource.data.expectedVolume.size() <= 40
        && request.resource.data.status == 'submitted';
      allow read, update, delete: if false;
    }

    // 백오피스 원장 — 클라이언트는 어느 쪽에서도 닿을 수 없다.
    // Admin SDK 는 규칙을 우회하므로 서버만 접근한다.
    match /buyers/{id}    { allow read, write: if false; }
    match /suppliers/{id} { allow read, write: if false; }
    match /deals/{id} {
      allow read, write: if false;
      match /{sub=**} { allow read, write: if false; }
    }
    match /messages/{id}  { allow read, write: if false; }
    match /threads/{id}   { allow read, write: if false; }
    match /intakeReviews/{id} { allow read, write: if false; }
    match /ingestState/{account} { allow read, write: if false; }

    // 그 외 모든 경로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
