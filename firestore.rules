rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // users/{uid}: 본인만. 권한 필드는 클라이언트 요청에 들어오지 않는다.
    match /users/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'phone', 'country', 'companyName',
          'provider', 'createdAt', 'isTest'
        ]);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phone', 'country', 'companyName', 'provider', 'isTest'
        ]);
      allow delete: if false;
    }

    // cmBriefs/{uid}: 본인만 읽기/쓰기 (setDoc/merge 사용)
    match /cmBriefs/{uid} {
      allow read, write: if isOwner(uid);
    }

    // orders/{orderId}: 본인 uid로만 생성, 본인 것만 읽기
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // sampleRequests/{requestId}: orders와 동일 패턴
    match /sampleRequests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // tracking/{uid}/entries/{entryId}: 본인 subcollection만 접근
    match /tracking/{uid} {
      allow read, write: if false;

      match /entries/{entryId} {
        allow read, write: if isOwner(uid);
      }
    }

    // test/{docId}: 로그인 사용자만
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // contact/{docId}: 문의 폼 — create만 허용. 두 가지 모양을 받는다.
    // - 리뉴얼 Contact(formVersion == 2, 2026-11): 필수·타입·길이·허용 필드 목록을 모두 검사(validContactV2)
    // - 기존 운영 Contact(formVersion 없음): 기존 검사 + 운영 폼이 실제로 보내는 필드만 허용(validContactLegacy).
    //   formVersion을 넣은 문서는 기존 검사로 통과할 수 없다(리뉴얼 검사 우회 방지)
    // uid는 로그인 상태에서 본인 것만. channelUserId는 브라우저 Channel Talk 사용자 id(서버가 이메일로 다시 검증).
    function validContactIdentity() {
      return (!('uid' in request.resource.data)
          || (isSignedIn() && request.resource.data.uid == request.auth.uid))
        && validLandingOptionalString('channelUserId', 64);
    }

    function validContactTracking() {
      return validLandingOptionalString('utmSource', 200)
        && validLandingOptionalString('utmMedium', 200)
        && validLandingOptionalString('utmCampaign', 200)
        && validLandingOptionalString('utmContent', 200)
        && validLandingOptionalString('utmTerm', 200)
        && validLandingOptionalString('pageUrl', 2000)
        && validLandingOptionalString('gaClientId', 200)
        && validLandingOptionalString('userAgent', 1000);
    }

    function validContactV2() {
      let data = request.resource.data;
      return data.keys().hasAll(['formVersion', 'fullName', 'email', 'companyName', 'country', 'productCategory', 'quantityPerSku', 'targetMarkets', 'isTest', 'status', 'createdAt', 'serverCreatedAt'])
        && data.keys().hasOnly(['formVersion', 'fullName', 'email', 'companyName', 'country', 'productCategory', 'quantityPerSku', 'targetMarkets', 'website', 'launchDate', 'message', 'promoInterest', 'utmSource', 'utmMedium', 'utmCampaign', 'utmContent', 'utmTerm', 'pageUrl', 'gaClientId', 'userAgent', 'uid', 'channelUserId', 'isTest', 'status', 'createdAt', 'serverCreatedAt'])
        && data.formVersion == 2
        && validLandingString(data.fullName, 100)
        && validLandingString(data.email, 254)
        && data.email.matches('.*@.*\\..*')
        && validLandingString(data.companyName, 200)
        && validLandingString(data.country, 100)
        && validLandingString(data.productCategory, 200)
        && data.quantityPerSku is int
        && data.quantityPerSku >= 5000
        && data.quantityPerSku <= 100000000
        && validLandingString(data.targetMarkets, 300)
        && validLandingOptionalString('website', 500)
        && validLandingOptionalString('launchDate', 100)
        && validLandingOptionalString('message', 5000)
        && (!('promoInterest' in data) || data.promoInterest is bool)
        && data.isTest is bool
        && data.status == 'submitted'
        && validLandingString(data.createdAt, 64)
        && data.serverCreatedAt == request.time;
    }

    function validContactLegacy() {
      let data = request.resource.data;
      return !('formVersion' in data)
        && data.keys().hasAll(['companyName', 'email', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['companyName', 'email', 'referralSource', 'businessType', 'message', 'utmSource', 'utmMedium', 'utmCampaign', 'utmContent', 'utmTerm', 'pageUrl', 'gaClientId', 'userAgent', 'uid', 'channelUserId', 'isTest', 'status', 'createdAt', 'serverCreatedAt'])
        && data.companyName is string
        && data.companyName.size() > 0
        && data.companyName.size() <= 200
        && data.email is string
        && data.email.matches('.*@.*\\..*')
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 5000
        && data.status == 'submitted';
    }

    match /contact/{docId} {
      allow create: if validContactIdentity()
        && ((('formVersion' in request.resource.data) && validContactV2() && validContactTracking())
          || validContactLegacy());
      allow read, update, delete: if false;
    }

    function validLandingString(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function validLandingOptionalString(key, max) {
      return !(key in request.resource.data) || (request.resource.data[key] is string && request.resource.data[key].size() <= max);
    }

    function validCatalogItem(item) {
      return item is map
        && item.keys().hasOnly(['id', 'name', 'category'])
        && validLandingString(item.id, 200)
        && validLandingString(item.name, 200)
        && item.category in ['serum', 'toner', 'cream', 'mist'];
    }

    function validCatalogItems(items) {
      return items is list
        && items.size() > 0
        && items.size() <= 5
        && validCatalogItem(items[0])
        && (items.size() < 2 || validCatalogItem(items[1]))
        && (items.size() < 3 || validCatalogItem(items[2]))
        && (items.size() < 4 || validCatalogItem(items[3]))
        && (items.size() < 5 || validCatalogItem(items[4]));
    }

    function validLandingCommon() {
      return request.resource.data.keys().hasAll(['landingVariant', 'companyName', 'contactName', 'email', 'country', 'expectedVolume', 'pageUrl', 'isTest', 'status', 'createdAt', 'serverCreatedAt'])
        && validLandingString(request.resource.data.companyName, 200)
        && validLandingString(request.resource.data.contactName, 120)
        && validLandingString(request.resource.data.email, 320)
        && request.resource.data.email.matches('.*@.*\\..*')
        && validLandingString(request.resource.data.country, 100)
        && validLandingString(request.resource.data.expectedVolume, 40)
        && validLandingString(request.resource.data.pageUrl, 2000)
        && request.resource.data.isTest is bool
        && request.resource.data.status == 'new'
        && validLandingString(request.resource.data.createdAt, 64)
        && request.resource.data.serverCreatedAt is timestamp
        && validLandingOptionalString('message', 5000)
        && validLandingOptionalString('referralSource', 200)
        && validLandingOptionalString('businessType', 200)
        && validLandingOptionalString('positioningArm', 200)
        && validLandingOptionalString('utmSource', 200)
        && validLandingOptionalString('utmMedium', 200)
        && validLandingOptionalString('utmCampaign', 200)
        && validLandingOptionalString('utmContent', 200)
        && validLandingOptionalString('utmTerm', 200)
        && validLandingOptionalString('gaClientId', 200)
        && validLandingOptionalString('userAgent', 1000)
        && validLandingOptionalString('channelUserId', 64);
    }

    match /landingRequests/{requestId} {
      allow create: if validLandingCommon()
        && ((request.resource.data.landingVariant == 'catalog'
          && request.resource.data.keys().hasOnly(['landingVariant', 'companyName', 'contactName', 'email', 'country', 'expectedVolume', 'message', 'catalogItems', 'utmSource', 'utmMedium', 'utmCampaign', 'utmContent', 'utmTerm', 'pageUrl', 'gaClientId', 'userAgent', 'channelUserId', 'isTest', 'status', 'createdAt', 'serverCreatedAt'])
          && validCatalogItems(request.resource.data.catalogItems))
          || (request.resource.data.landingVariant == 'dashboard'
          && request.resource.data.keys().hasOnly(['landingVariant', 'companyName', 'contactName', 'email', 'country', 'expectedVolume', 'message', 'dashboardBrief', 'utmSource', 'utmMedium', 'utmCampaign', 'utmContent', 'utmTerm', 'pageUrl', 'gaClientId', 'userAgent', 'channelUserId', 'isTest', 'status', 'createdAt', 'serverCreatedAt'])
          && request.resource.data.dashboardBrief is map)
          || (request.resource.data.landingVariant == 'korea'
          && request.resource.data.keys().hasOnly(['landingVariant', 'companyName', 'contactName', 'email', 'country', 'expectedVolume', 'message', 'referralSource', 'businessType', 'positioningArm', 'utmSource', 'utmMedium', 'utmCampaign', 'utmContent', 'utmTerm', 'pageUrl', 'gaClientId', 'userAgent', 'channelUserId', 'isTest', 'status', 'createdAt', 'serverCreatedAt'])));
      allow read, update, delete: if false;
    }

    // 백오피스 원장 — 클라이언트는 어느 쪽에서도 닿을 수 없다.
    // Admin SDK 는 규칙을 우회하므로 서버만 접근한다.
    match /buyers/{id}    { allow read, write: if false; }
    match /suppliers/{id} { allow read, write: if false; }
    match /deals/{id} {
      allow read, write: if false;
      match /{sub=**} { allow read, write: if false; }
    }
    match /messages/{id}  { allow read, write: if false; }
    match /threads/{id}   { allow read, write: if false; }
    match /conversationIdentities/{id} { allow read, write: if false; }
    match /conversations/{id} {
      allow read, write: if false;
      match /brief/{briefId} { allow read, write: if false; }
      match /events/{eventId} { allow read, write: if false; }
    }
    match /intakeReviews/{id} { allow read, write: if false; }
    match /ingestState/{account} { allow read, write: if false; }

    // Channel Talk 연동 장부 — 서버(Admin SDK)만 접근한다.
    match /channelTalkIdentities/{id} { allow read, write: if false; }
    match /channelTalkSync/{id}       { allow read, write: if false; }
    // lastContactAt 쓰기 중단 플래그 — 서버(Admin SDK)만 접근한다.
    match /channelTalkControl/{id}    { allow read, write: if false; }

    // 그 외 모든 경로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
