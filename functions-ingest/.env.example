# Comma-separated Gmail mailboxes to poll (loaded via firebase-functions params).
# The code allowlists all six known mailboxes. Only the two medidakoslabs
# accounts are currently delegation-verified; adding a techasset mailbox
# before its domain-wide delegation is verified records a per-account failure.
INGEST_MAILBOXES=thomas@medidakoslabs.com,hally@medidakoslabs.com

# Empty means a bounded 30-day initial Gmail/Graph backfill. Use an explicit
# ISO timestamp only after the backfill window is approved.
INGEST_INITIAL_AFTER=

# Outlook and Channel Talk are Plan 8 work: their concrete Secret Manager
# bindings are intentionally absent until real credentials and read-only
# provider fixtures have been approved. Never put their values in this file.
